<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NSE Market Rotation Compass — {{ payload.as_of_date }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
  :root{
    --bg:#0B0E14; --surface:#12161F; --surface-2:#161B26; --hairline:#232838;
    --text:#E6E9F0; --text-dim:#8B93A7; --amber:#FFB454; --cyan:#4FC3F7;
    --up:#3DDC97; --down:#FF6B5C;
    --leading:#3DDC97; --weakening:#FFB454; --lagging:#FF6B5C; --improving:#4FC3F7;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;background:var(--bg);color:var(--text); font-family:'IBM Plex Sans',system-ui,sans-serif;}
  .mono{font-family:'IBM Plex Mono',monospace; font-variant-numeric: tabular-nums;}
  a{color:var(--cyan); text-decoration:none;} a:hover{text-decoration:underline;}
  button{font-family:inherit;}
  .topbar{display:flex; justify-content:space-between; align-items:center; padding:12px 20px;
    border-bottom:1px solid var(--hairline); background:var(--surface); flex-wrap:wrap; gap:8px;}
  .topbar .brand{font-size:15px; letter-spacing:.08em; text-transform:uppercase; font-weight:700;}
  .topbar .brand b{color:var(--amber);}
  .topbar .meta{font-size:12px; color:var(--text-dim);}
  main{padding:20px; max-width:1400px; margin:0 auto;}

  .controls{display:flex; flex-wrap:wrap; gap:10px; align-items:center; background:var(--surface);
    border:1px solid var(--hairline); padding:12px 14px; margin-bottom:16px;}
  .control-group{display:flex; align-items:center; gap:6px;}
  .control-label{font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-dim); margin-right:2px;}
  .btn{background:var(--surface-2); border:1px solid var(--hairline); color:var(--text-dim);
    padding:6px 12px; font-size:12px; cursor:pointer; letter-spacing:.02em;}
  .btn:hover{color:var(--text); border-color:var(--cyan);}
  .btn.active{background:var(--amber); color:#0B0E14; border-color:var(--amber); font-weight:600;}
  select, input[type=text]{background:var(--surface-2); border:1px solid var(--hairline); color:var(--text);
    padding:6px 10px; font-size:12px; font-family:inherit;}
  #search{width:200px;}

  .grid{display:grid; grid-template-columns: 3fr 1fr; gap:16px;}
  @media (max-width: 1000px){ .grid{grid-template-columns: 1fr;} }

  .panel{background:var(--surface); border:1px solid var(--hairline); margin-bottom:16px;}
  .panel-head{display:flex; justify-content:space-between; align-items:center; padding:10px 14px; border-bottom:1px solid var(--hairline);}
  .panel-head h2{font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); margin:0; font-weight:600;}
  .chart-wrap{padding:12px;}

  .quad-legend{display:flex; gap:14px; padding:8px 14px; font-size:11px; color:var(--text-dim); flex-wrap:wrap;}
  .quad-legend span{display:inline-flex; align-items:center; gap:5px;}
  .dot{width:8px; height:8px; display:inline-block; border-radius:50%;}

  .side-list{padding:6px 0;}
  .side-item{display:flex; justify-content:space-between; padding:7px 14px; font-size:12px; border-bottom:1px solid var(--hairline); cursor:pointer;}
  .side-item:hover{background:var(--surface-2);}
  .side-item:last-child{border-bottom:none;}
  .badge{font-size:9px; padding:1px 5px; letter-spacing:.04em; border:1px solid currentColor;}
  .badge.OFFICIAL{color:var(--cyan);} .badge.CUSTOM{color:var(--amber);}

  table{width:100%; border-collapse:collapse; font-size:12.5px;}
  th{text-align:left; font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-dim);
    font-weight:500; padding:8px 10px; border-bottom:1px solid var(--hairline); cursor:pointer; user-select:none; white-space:nowrap;}
  th.num, td.num{text-align:right;}
  td{padding:7px 10px; border-bottom:1px solid var(--hairline); white-space:nowrap;}
  tbody tr:hover{background:var(--surface-2); cursor:pointer;}
  tbody tr.selected{background:rgba(255,180,84,0.12);}
  tbody tr:last-child td{border-bottom:none;}
  .quad-pill{font-size:10px; padding:2px 7px; font-weight:600; letter-spacing:.03em;}
  .quad-pill.LEADING{background:rgba(61,220,151,0.18); color:var(--leading);}
  .quad-pill.WEAKENING{background:rgba(255,180,84,0.18); color:var(--weakening);}
  .quad-pill.LAGGING{background:rgba(255,107,92,0.18); color:var(--lagging);}
  .quad-pill.IMPROVING{background:rgba(79,195,247,0.18); color:var(--improving);}
  .table-scroll{overflow-x:auto;}

  .vis-list{max-height:260px; overflow-y:auto; padding:4px 14px;}
  .vis-item{display:flex; align-items:center; gap:8px; padding:4px 0; font-size:12px;}
  .vis-item input{accent-color:var(--amber);}

  #detail-panel{display:none;}
  #detail-panel.open{display:block;}
  .detail-grid{display:grid; grid-template-columns:2fr 1fr; gap:16px; padding:14px;}
  @media (max-width: 900px){ .detail-grid{grid-template-columns:1fr;} }
  .stat-strip{display:flex; flex-wrap:wrap; border:1px solid var(--hairline); margin-bottom:12px;}
  .stat{flex:1; min-width:100px; padding:10px 12px; border-right:1px solid var(--hairline);}
  .stat:last-child{border-right:none;}
  .stat .label{font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-dim);}
  .stat .value{font-size:15px; font-weight:600; margin-top:2px;}
  .close-btn{background:none; border:none; color:var(--text-dim); font-size:18px; cursor:pointer;}
  .close-btn:hover{color:var(--text);}

  footer{padding:20px; text-align:center; color:var(--text-dim); font-size:11px; border-top:1px solid var(--hairline); margin-top:20px;}
  .validation-msg{padding:6px 14px; font-size:11px; border-bottom:1px solid var(--hairline);}
  .validation-msg.ERROR{color:var(--down);} .validation-msg.WARN{color:var(--amber);} .validation-msg.CRITICAL{color:var(--down); font-weight:700;}
</style>
</head>
<body>
  <div class="topbar">
    <div class="brand"><b>NSE</b> Market Rotation Compass</div>
    <div class="meta mono">Config {{ payload.config_hash }} &middot; As of {{ payload.as_of_date }}</div>
  </div>

  <main>
    <div class="controls">
      <div class="control-group">
        <span class="control-label">Benchmark</span>
        <select id="benchmark-select"></select>
      </div>
      <div class="control-group">
        <span class="control-label">Universe</span>
        <select id="universe-select"></select>
      </div>
      <div class="control-group">
        <span class="control-label">Timeframe</span>
        <button class="btn" data-tf="DAILY">Daily</button>
        <button class="btn" data-tf="WEEKLY">Weekly</button>
        <button class="btn" data-tf="MONTHLY">Monthly</button>
      </div>
      <div class="control-group">
        <span class="control-label">Trail</span>
        <select id="trail-select"></select>
      </div>
      <div class="control-group">
        <span class="control-label">Quadrant</span>
        <button class="btn" data-quad="ALL">All</button>
        <button class="btn" data-quad="LEADING">Leading</button>
        <button class="btn" data-quad="IMPROVING">Improving</button>
        <button class="btn" data-quad="LEADING_IMPROVING">Leading+Improving</button>
        <button class="btn" data-quad="WEAKENING">Weakening</button>
        <button class="btn" data-quad="LAGGING">Lagging</button>
      </div>
      <div class="control-group">
        <span class="control-label">Category</span>
        <button class="btn" data-cat="ALL">All</button>
        <button class="btn" data-cat="OFFICIAL">Official</button>
        <button class="btn" data-cat="CUSTOM">Custom</button>
      </div>
      <div class="control-group">
        <input id="search" type="text" placeholder="Search index...">
      </div>
      <div class="control-group">
        <button class="btn" id="reset-btn">Reset Filters</button>
      </div>
    </div>

    <div class="grid">
      <div class="panel">
        <div class="panel-head">
          <h2>Relative Rotation Graph</h2>
          <span class="mono" id="chart-caption" style="font-size:11px; color:var(--text-dim);"></span>
        </div>
        <div class="quad-legend">
          <span><span class="dot" style="background:var(--improving);"></span>Improving</span>
          <span><span class="dot" style="background:var(--leading);"></span>Leading</span>
          <span><span class="dot" style="background:var(--lagging);"></span>Lagging</span>
          <span><span class="dot" style="background:var(--weakening);"></span>Weakening</span>
        </div>
        <div class="chart-wrap"><canvas id="rrg-chart" height="110"></canvas></div>
      </div>

      <div>
        <div class="panel">
          <div class="panel-head"><h2>Leading</h2></div>
          <div class="side-list" id="leading-list"></div>
        </div>
        <div class="panel">
          <div class="panel-head"><h2>Improving</h2></div>
          <div class="side-list" id="improving-list"></div>
        </div>
        <div class="panel">
          <div class="panel-head"><h2>Index Visibility</h2></div>
          <div class="vis-list" id="vis-list"></div>
        </div>
      </div>
    </div>

    <div class="panel" id="detail-panel">
      <div class="panel-head">
        <h2 id="detail-title">Index Detail</h2>
        <button class="close-btn" id="detail-close">&times;</button>
      </div>
      <div class="detail-grid" id="detail-body"></div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Official vs Custom</h2></div>
      <div class="table-scroll">
        <table id="comparison-table">
          <thead><tr><th>Sector</th><th>Official RS-Ratio</th><th>Official Quadrant</th>
                      <th>Custom RS-Ratio</th><th>Custom Quadrant</th><th class="num">Delta (Custom - Official)</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Multi-Timeframe Rotation Matrix</h2></div>
      <div class="table-scroll">
        <table id="matrix-table">
          <thead><tr><th>Index</th><th>Category</th><th>Daily</th><th>Weekly</th><th>Monthly</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Rotation Table &middot; <span id="table-timeframe-label"></span></h2></div>
      <div class="table-scroll">
        <table id="rotation-table">
          <thead>
            <tr>
              <th data-sort="relative_rank">Rank</th>
              <th data-sort="name">Index</th>
              <th data-sort="category">Type</th>
              <th data-sort="cap_band">Cap</th>
              <th data-sort="constituent_count" class="num">Constituents</th>
              <th data-sort="rs_ratio" class="num">RS-Ratio</th>
              <th data-sort="rs_momentum" class="num">RS-Momentum</th>
              <th data-sort="quadrant">Quadrant</th>
              <th data-sort="direction_deg" class="num">Direction</th>
              <th data-sort="rotation_speed" class="num">Speed</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Data Quality</h2></div>
      <div id="validation-list"></div>
    </div>
  </main>

  <footer>
    Transparent, original RRG methodology &mdash; not a reproduction of any proprietary indicator. See METHODOLOGY.md in the repo for the exact formulas.
    Not investment advice.
  </footer>

<script>
const DATA = {{ data_json | tojson }};

const QUAD_COLORS = { LEADING: '#3DDC97', WEAKENING: '#FFB454', LAGGING: '#FF6B5C', IMPROVING: '#4FC3F7' };
const PALETTE = ['#4FC3F7','#FFB454','#3DDC97','#FF6B5C','#B39DDB','#F48FB1','#80CBC4','#FFD54F','#90CAF9','#A5D6A7','#EF9A9A','#CE93D8'];

const state = {
  benchmark: DATA.default_benchmark_code,
  universe: DATA.universes[0],
  timeframe: 'WEEKLY',
  trailLength: DATA.trail_default_periods,
  quadrant: 'ALL',
  category: 'ALL',
  search: '',
  visible: new Set(DATA.indices.map(i => i.code)),
  selected: null,
  sortColumn: 'relative_rank',
  sortDir: 'asc',
};

function colorFor(code) {
  const idx = DATA.indices.findIndex(i => i.code === code);
  return PALETTE[idx % PALETTE.length];
}

function currentPoint(indexObj) {
  const byBenchmark = indexObj.trails[state.benchmark];
  if (!byBenchmark) return null;
  const trail = byBenchmark[state.timeframe];
  if (!trail || trail.length === 0) return null;
  return trail[trail.length - 1];
}

function passesUniverseFilter(indexObj) {
  // Official indices aren't universe-scoped -- they always pass. Custom
  // indices (and their cap-band sub-indices) only show for the currently
  // selected universe.
  if (indexObj.category === 'OFFICIAL') return true;
  return indexObj.universe_code === state.universe;
}

function passesNonVisibilityFilters(indexObj, point) {
  if (!passesUniverseFilter(indexObj)) return false;
  if (state.category !== 'ALL' && indexObj.category !== state.category) return false;
  if (state.search && !(indexObj.name.toLowerCase().includes(state.search) || indexObj.code.toLowerCase().includes(state.search))) return false;
  if (!point) return false;
  if (state.quadrant === 'LEADING_IMPROVING') {
    if (point.quadrant !== 'LEADING' && point.quadrant !== 'IMPROVING') return false;
  } else if (state.quadrant !== 'ALL' && point.quadrant !== state.quadrant) {
    return false;
  }
  return true;
}

// ---------- Chart ----------
const quadrantBackgroundPlugin = {
  id: 'quadrantBackground',
  beforeDraw(chart) {
    const { ctx, chartArea, scales } = chart;
    if (!chartArea) return;
    const xC = scales.x.getPixelForValue(100);
    const yC = scales.y.getPixelForValue(100);
    const { left, right, top, bottom } = chartArea;
    ctx.save();
    ctx.fillStyle = 'rgba(79,195,247,0.06)';  ctx.fillRect(left, top, xC-left, yC-top);        // Improving
    ctx.fillStyle = 'rgba(61,220,151,0.08)';  ctx.fillRect(xC, top, right-xC, yC-top);          // Leading
    ctx.fillStyle = 'rgba(255,107,92,0.06)';  ctx.fillRect(left, yC, xC-left, bottom-yC);        // Lagging
    ctx.fillStyle = 'rgba(255,180,84,0.08)';  ctx.fillRect(xC, yC, right-xC, bottom-yC);         // Weakening
    ctx.strokeStyle = '#232838'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(xC, top); ctx.lineTo(xC, bottom); ctx.moveTo(left, yC); ctx.lineTo(right, yC); ctx.stroke();
    ctx.font = '10px IBM Plex Mono'; ctx.fillStyle = '#8B93A7';
    ctx.fillText('IMPROVING', left+6, top+12);
    ctx.fillText('LEADING', right-52, top+12);
    ctx.fillText('LAGGING', left+6, bottom-6);
    ctx.fillText('WEAKENING', right-62, bottom-6);
    ctx.restore();
  }
};

let chart;
let chartAvailable = false;

function buildChart() {
  // Chart.js loads from a CDN (see <head>). If it fails to load for any
  // reason -- an ad blocker, a corporate network filter, offline use, a CDN
  // outage -- `Chart` is undefined and `new Chart(...)` throws. That
  // exception must NEVER be allowed to escape uncaught: an earlier version
  // of this dashboard called buildChart() first, before anything else, so
  // an uncaught error here silently aborted the ENTIRE script -- the
  // rotation table, matrix, comparison panel, and side lists never
  // populated at all, leaving only the static page skeleton visible. This
  // is now caught explicitly, and every other panel renders independently
  // of whether the chart itself is available.
  try {
    if (typeof Chart === 'undefined') {
      throw new Error('Chart.js did not load (CDN blocked, offline, or ad-blocker) -- ' +
        'the RRG chart is unavailable, but the rest of the dashboard still works.');
    }
    const ctx = document.getElementById('rrg-chart');
    chart = new Chart(ctx, {
      type: 'scatter',
      data: { datasets: [] },
      options: {
        responsive: true,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (item) => {
                const ds = item.dataset;
                return `${ds.label}: RS-Ratio ${item.parsed.x.toFixed(2)}, RS-Momentum ${item.parsed.y.toFixed(2)}`;
              }
            }
          }
        },
        scales: {
          x: { min: DATA.axis_bounds.x_min, max: DATA.axis_bounds.x_max, title: { display: true, text: 'RS-Ratio', color: '#8B93A7' },
               grid: { color: '#1a1f2b' }, ticks: { color: '#8B93A7' } },
          y: { min: DATA.axis_bounds.y_min, max: DATA.axis_bounds.y_max, title: { display: true, text: 'RS-Momentum', color: '#8B93A7' },
               grid: { color: '#1a1f2b' }, ticks: { color: '#8B93A7' } },
        },
        onClick: (evt, elements) => {
          if (elements.length > 0) {
            const code = chart.data.datasets[elements[0].datasetIndex].indexCode;
            selectIndex(code);
          }
        }
      },
      plugins: [quadrantBackgroundPlugin]
    });
    chartAvailable = true;
  } catch (err) {
    chartAvailable = false;
    const wrap = document.querySelector('.chart-wrap');
    if (wrap) {
      wrap.innerHTML = `<div style="padding:24px; color:var(--text-dim); font-size:13px; border:1px dashed var(--hairline);">
        RRG chart unavailable: ${err.message}<br><br>
        This does not affect the Rotation Table, Multi-Timeframe Matrix, Official vs Custom panel, or any other data below -- only the visual scatter chart failed to load.
      </div>`;
    }
    const caption = document.getElementById('chart-caption');
    if (caption) caption.innerText = 'chart unavailable -- see message below';
    console.warn('RRG chart could not be initialized:', err);
  }
}

function updateChart() {
  if (!chartAvailable) return;
  const datasets = [];
  DATA.indices.forEach(indexObj => {
    if (!state.visible.has(indexObj.code)) return;
    const point = currentPoint(indexObj);
    if (!passesNonVisibilityFilters(indexObj, point)) return;

    const byBenchmark = indexObj.trails[state.benchmark] || {};
    const fullTrail = byBenchmark[state.timeframe] || [];
    const trail = fullTrail.slice(Math.max(0, fullTrail.length - state.trailLength));
    if (trail.length === 0) return;

    const color = colorFor(indexObj.code);
    const isSelected = state.selected === indexObj.code;
    const pointRadii = trail.map((p, i) => i === trail.length - 1 ? (isSelected ? 9 : 6) : 2.5);
    const pointStyles = trail.map((p, i) => i === trail.length - 1 ? 'circle' : 'circle');

    datasets.push({
      label: indexObj.name,
      indexCode: indexObj.code,
      data: trail.map(p => ({ x: p.rs_ratio, y: p.rs_momentum })),
      showLine: true,
      borderColor: color,
      backgroundColor: color,
      borderWidth: isSelected ? 2.5 : 1,
      pointRadius: pointRadii,
      pointStyle: pointStyles,
      pointBackgroundColor: color,
      pointBorderColor: isSelected ? '#fff' : color,
      order: isSelected ? 0 : 1,
    });
  });
  chart.data.datasets = datasets;
  chart.update();
  document.getElementById('chart-caption').innerText = `${datasets.length} of ${DATA.indices.length} indices shown \u00b7 trail ${state.trailLength} bars`;
}

// ---------- Rotation table + matrix (derived from the SAME trail data as the chart) ----------
function computeRotationRows() {
  const rows = [];
  DATA.indices.forEach(indexObj => {
    const point = currentPoint(indexObj);
    if (!point) return;
    rows.push({
      code: indexObj.code, name: indexObj.name, category: indexObj.category,
      cap_band: indexObj.cap_band || '—',
      constituent_count: indexObj.constituents.length ? indexObj.constituents.length : null,
      rs_ratio: point.rs_ratio, rs_momentum: point.rs_momentum, quadrant: point.quadrant,
      direction_deg: point.direction_deg, rotation_speed: point.rotation_speed,
    });
  });
  rows.sort((a, b) => b.rs_ratio - a.rs_ratio);
  rows.forEach((r, i) => r.relative_rank = i + 1);
  return rows;
}

function renderTable() {
  document.getElementById('table-timeframe-label').innerText = state.timeframe;
  let rows = computeRotationRows().filter(r => {
    const indexObj = DATA.indices.find(i => i.code === r.code);
    if (!state.visible.has(r.code)) return false;
    return passesNonVisibilityFilters(indexObj, r);
  });
  rows.sort((a, b) => {
    let av = a[state.sortColumn], bv = b[state.sortColumn];
    if (av === null) av = -Infinity; if (bv === null) bv = -Infinity;
    if (typeof av === 'string') return state.sortDir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
    return state.sortDir === 'asc' ? av - bv : bv - av;
  });
  const tbody = document.querySelector('#rotation-table tbody');
  tbody.innerHTML = '';
  rows.forEach(r => {
    const tr = document.createElement('tr');
    if (r.code === state.selected) tr.classList.add('selected');
    tr.innerHTML = `
      <td class="mono num">${r.relative_rank}</td>
      <td>${r.name}</td>
      <td><span class="badge ${r.category}">${r.category}</span></td>
      <td class="mono">${r.cap_band}</td>
      <td class="mono num">${r.constituent_count ?? '—'}</td>
      <td class="mono num">${r.rs_ratio.toFixed(2)}</td>
      <td class="mono num">${r.rs_momentum.toFixed(2)}</td>
      <td><span class="quad-pill ${r.quadrant}">${r.quadrant}</span></td>
      <td class="mono num">${r.direction_deg !== null ? r.direction_deg.toFixed(0) + '\u00b0' : '—'}</td>
      <td class="mono num">${r.rotation_speed !== null ? r.rotation_speed.toFixed(2) : '—'}</td>
    `;
    tr.addEventListener('click', () => selectIndex(r.code));
    tbody.appendChild(tr);
  });
}

function renderMatrix() {
  const tbody = document.querySelector('#matrix-table tbody');
  tbody.innerHTML = '';
  DATA.indices.forEach(indexObj => {
    if (!state.visible.has(indexObj.code) || !passesUniverseFilter(indexObj)) return;
    const byBenchmark = indexObj.trails[state.benchmark] || {};
    const cells = DATA.timeframes.map(tf => {
      const trail = byBenchmark[tf];
      const last = trail && trail.length ? trail[trail.length - 1] : null;
      return last ? `<td><span class="quad-pill ${last.quadrant}">${last.quadrant}</span></td>` : '<td>—</td>';
    }).join('');
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${indexObj.name}</td><td><span class="badge ${indexObj.category}">${indexObj.category}</span></td>${cells}`;
    tr.addEventListener('click', () => selectIndex(indexObj.code));
    tbody.appendChild(tr);
  });
}

function renderSideLists() {
  const leading = [], improving = [];
  DATA.indices.forEach(indexObj => {
    const point = currentPoint(indexObj);
    if (!point || !state.visible.has(indexObj.code)) return;
    if (point.quadrant === 'LEADING') leading.push({ indexObj, point });
    if (point.quadrant === 'IMPROVING') improving.push({ indexObj, point });
  });
  leading.sort((a, b) => b.point.rs_ratio - a.point.rs_ratio);
  improving.sort((a, b) => b.point.rs_momentum - a.point.rs_momentum);

  const render = (list, elId) => {
    const el = document.getElementById(elId);
    el.innerHTML = '';
    if (list.length === 0) { el.innerHTML = '<div class="side-item" style="color:var(--text-dim);">None currently</div>'; return; }
    list.forEach(({ indexObj, point }) => {
      const div = document.createElement('div');
      div.className = 'side-item';
      div.innerHTML = `<span>${indexObj.name} <span class="badge ${indexObj.category}">${indexObj.category}</span></span><span class="mono">${point.rs_ratio.toFixed(1)}</span>`;
      div.addEventListener('click', () => selectIndex(indexObj.code));
      el.appendChild(div);
    });
  };
  render(leading, 'leading-list');
  render(improving, 'improving-list');
}

function renderVisibilityList() {
  const el = document.getElementById('vis-list');
  el.innerHTML = '';
  DATA.indices.filter(passesUniverseFilter).forEach(indexObj => {
    const div = document.createElement('div');
    div.className = 'vis-item';
    const id = `vis-${indexObj.code}`;
    div.innerHTML = `<input type="checkbox" id="${id}" ${state.visible.has(indexObj.code) ? 'checked' : ''}>
                      <label for="${id}">${indexObj.name} <span class="badge ${indexObj.category}">${indexObj.category}</span></label>`;
    div.querySelector('input').addEventListener('change', (e) => {
      if (e.target.checked) state.visible.add(indexObj.code); else state.visible.delete(indexObj.code);
      renderAll();
    });
    el.appendChild(div);
  });
}

function renderValidation() {
  const el = document.getElementById('validation-list');
  el.innerHTML = '';
  const v = DATA.validation;
  const summary = document.createElement('div');
  summary.className = 'validation-msg';
  const countsStr = Object.entries(v.counts).map(([k, n]) => `${k}: ${n}`).join('  ') || 'No findings';
  summary.innerText = `Validation run ${v.run_id} — ${countsStr}`;
  el.appendChild(summary);
  v.messages.forEach(m => {
    const div = document.createElement('div');
    div.className = `validation-msg ${m.severity}`;
    div.innerText = `[${m.severity}] ${m.module}: ${m.message}`;
    el.appendChild(div);
  });
}

function selectIndex(code) {
  state.selected = code;
  const indexObj = DATA.indices.find(i => i.code === code);
  const panel = document.getElementById('detail-panel');
  panel.classList.add('open');
  document.getElementById('detail-title').innerText = `${indexObj.name} (${indexObj.code})`;

  const point = currentPoint(indexObj) || {};
  const byBenchmark = indexObj.trails[state.benchmark] || {};
  const matrixCells = DATA.timeframes.map(tf => {
    const trail = byBenchmark[tf];
    const last = trail && trail.length ? trail[trail.length - 1] : null;
    return `<div class="stat"><div class="label">${tf}</div><div class="value">${last ? `<span class="quad-pill ${last.quadrant}">${last.quadrant}</span>` : '—'}</div></div>`;
  }).join('');

  let constituentsHtml = '<p style="color:var(--text-dim); font-size:12px;">Official index — not constructed from constituents.</p>';
  if (indexObj.constituents.length) {
    const rows = indexObj.constituents.map(c => `<tr><td class="mono">${c.symbol}</td><td>${c.name}</td><td class="num mono">${c.weight}%</td></tr>`).join('');
    constituentsHtml = `<table><thead><tr><th>Symbol</th><th>Name</th><th class="num">Weight</th></tr></thead><tbody>${rows}</tbody></table>`;
  }

  document.getElementById('detail-body').innerHTML = `
    <div>
      <div class="stat-strip">
        <div class="stat"><div class="label">Category</div><div class="value"><span class="badge ${indexObj.category}">${indexObj.category}</span></div></div>
        <div class="stat"><div class="label">Universe</div><div class="value mono">${indexObj.universe_code || 'N/A'}</div></div>
        <div class="stat"><div class="label">Cap Band</div><div class="value mono">${indexObj.cap_band || 'All caps'}</div></div>
        <div class="stat"><div class="label">Weighting</div><div class="value">${indexObj.weighting_method || 'N/A (official)'}</div></div>
        <div class="stat"><div class="label">RS-Ratio</div><div class="value mono">${point.rs_ratio ? point.rs_ratio.toFixed(2) : '—'}</div></div>
        <div class="stat"><div class="label">RS-Momentum</div><div class="value mono">${point.rs_momentum ? point.rs_momentum.toFixed(2) : '—'}</div></div>
      </div>
      <div class="stat-strip">${matrixCells}</div>
      <h3 style="font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-dim);">Constituents</h3>
      ${constituentsHtml}
    </div>
    <div>
      <h3 style="font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-dim); margin-top:0;">Recent Trail (${state.benchmark} / ${state.timeframe})</h3>
      <table><thead><tr><th>Date</th><th class="num">RS-Ratio</th><th class="num">RS-Mom</th><th>Quad</th></tr></thead>
      <tbody>${(byBenchmark[state.timeframe] || []).slice().reverse().slice(0, 10).map(p =>
        `<tr><td class="mono">${p.date}</td><td class="num mono">${p.rs_ratio.toFixed(2)}</td><td class="num mono">${p.rs_momentum.toFixed(2)}</td><td><span class="quad-pill ${p.quadrant}">${p.quadrant}</span></td></tr>`
      ).join('')}</tbody></table>
    </div>
  `;
  renderAll();
}

function renderComparison() {
  const tbody = document.querySelector('#comparison-table tbody');
  tbody.innerHTML = '';
  DATA.comparison_pairs
    .filter(p => p.universe_code === state.universe)
    .forEach(pair => {
      const official = DATA.indices.find(i => i.code === pair.official_code);
      const custom = DATA.indices.find(i => i.code === pair.custom_code);
      if (!official || !custom) return;
      const oPoint = currentPoint(official);
      const cPoint = currentPoint(custom);
      if (!oPoint || !cPoint) return;
      const delta = (cPoint.rs_ratio - oPoint.rs_ratio).toFixed(2);
      const deltaCls = delta > 0 ? 'up' : (delta < 0 ? 'down' : 'flat');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${pair.label}</td>
        <td class="mono num">${oPoint.rs_ratio.toFixed(2)}</td>
        <td><span class="quad-pill ${oPoint.quadrant}">${oPoint.quadrant}</span></td>
        <td class="mono num">${cPoint.rs_ratio.toFixed(2)}</td>
        <td><span class="quad-pill ${cPoint.quadrant}">${cPoint.quadrant}</span></td>
        <td class="mono num ${deltaCls}">${delta > 0 ? '+' : ''}${delta}</td>
      `;
      tr.addEventListener('click', () => selectIndex(custom.code));
      tbody.appendChild(tr);
    });
  if (!tbody.children.length) {
    tbody.innerHTML = '<tr><td colspan="6" style="color:var(--text-dim);">No official/custom pairs with data for this universe yet.</td></tr>';
  }
}

function renderAll() {
  // Each panel renders independently -- a failure in one (e.g. an
  // unexpected data shape for one exotic index) must not prevent the
  // others from showing. See buildChart()'s docstring for the motivating
  // bug this defensive pattern fixes project-wide.
  const steps = [updateChart, renderTable, renderMatrix, renderSideLists, renderComparison];
  for (const step of steps) {
    try { step(); } catch (err) { console.warn(`${step.name} failed:`, err); }
  }
}

// ---------- Controls wiring ----------
function initControls() {
  const benchmarkSelect = document.getElementById('benchmark-select');
  DATA.benchmarks.forEach(b => {
    const opt = document.createElement('option');
    opt.value = b.code; opt.innerText = b.name;
    if (b.code === state.benchmark) opt.selected = true;
    benchmarkSelect.appendChild(opt);
  });
  benchmarkSelect.addEventListener('change', () => { state.benchmark = benchmarkSelect.value; renderAll(); });

  const universeSelect = document.getElementById('universe-select');
  DATA.universes.forEach(u => {
    const opt = document.createElement('option');
    opt.value = u; opt.innerText = u;
    if (u === state.universe) opt.selected = true;
    universeSelect.appendChild(opt);
  });
  universeSelect.addEventListener('change', () => { state.universe = universeSelect.value; renderVisibilityList(); renderAll(); });

  document.querySelectorAll('[data-tf]').forEach(btn => {
    if (btn.dataset.tf === state.timeframe) btn.classList.add('active');
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-tf]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.timeframe = btn.dataset.tf;
      renderAll();
    });
  });

  const trailSelect = document.getElementById('trail-select');
  DATA.trail_allowed_periods.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p; opt.innerText = `${p} periods`;
    if (p === state.trailLength) opt.selected = true;
    trailSelect.appendChild(opt);
  });
  trailSelect.addEventListener('change', () => { state.trailLength = parseInt(trailSelect.value, 10); renderAll(); });

  document.querySelectorAll('[data-quad]').forEach(btn => {
    if (btn.dataset.quad === state.quadrant) btn.classList.add('active');
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-quad]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.quadrant = btn.dataset.quad;
      renderAll();
    });
  });

  document.querySelectorAll('[data-cat]').forEach(btn => {
    if (btn.dataset.cat === state.category) btn.classList.add('active');
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-cat]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.category = btn.dataset.cat;
      renderAll();
    });
  });

  document.getElementById('search').addEventListener('input', (e) => {
    state.search = e.target.value.trim().toLowerCase();
    renderAll();
  });

  document.getElementById('reset-btn').addEventListener('click', () => {
    state.quadrant = 'ALL'; state.category = 'ALL'; state.search = '';
    state.trailLength = DATA.trail_default_periods;
    state.benchmark = DATA.default_benchmark_code;
    state.universe = DATA.universes[0];
    state.visible = new Set(DATA.indices.map(i => i.code));
    document.getElementById('search').value = '';
    trailSelect.value = state.trailLength;
    benchmarkSelect.value = state.benchmark;
    universeSelect.value = state.universe;
    document.querySelectorAll('[data-quad]').forEach(b => b.classList.toggle('active', b.dataset.quad === 'ALL'));
    document.querySelectorAll('[data-cat]').forEach(b => b.classList.toggle('active', b.dataset.cat === 'ALL'));
    renderVisibilityList();
    renderAll();
  });

  document.getElementById('detail-close').addEventListener('click', () => {
    state.selected = null;
    document.getElementById('detail-panel').classList.remove('open');
    renderAll();
  });

  document.querySelectorAll('#rotation-table th[data-sort]').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.sort;
      if (state.sortColumn === col) state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
      else { state.sortColumn = col; state.sortDir = 'asc'; }
      renderTable();
    });
  });
}

// Bootstrap. Each step is isolated -- a failure in any one (chart init,
// control wiring, etc.) is caught and logged rather than aborting the whole
// script, so the rest of the dashboard still renders. This is the direct
// fix for a real bug: an earlier version ran these unguarded and in an
// order where a Chart.js load failure (network-blocked CDN, ad blocker,
// offline use) silently prevented EVERYTHING after it from ever running,
// leaving only the static page skeleton visible with no data anywhere.
[buildChart, initControls, renderVisibilityList, renderValidation, renderAll].forEach((fn) => {
  try { fn(); } catch (err) { console.warn(`${fn.name} failed during startup:`, err); }
});
</script>
</body>
</html>
